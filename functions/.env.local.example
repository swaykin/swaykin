# Copy to .env.local (gitignored via *.local) and fill in real values.
# GOOGLE_CLIENT_SECRET is NOT set here — see setup guide, it goes in
# .secret.local instead (also gitignored) or Secret Manager for deploys.

GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/swaykin-ai/us-central1/googleSignInCallback
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

# Optional override for the Bright Data dataset id (defaults to gd_l1vikfch901nx3by4).
BRIGHTDATA_DATASET_ID=
